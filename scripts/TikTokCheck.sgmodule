#!name=TikTok 解锁检测 Panel
#!desc=TikTok 解锁检测，支持在模块 UI 菜单中选择检测节点/策略
#!category=检测工具
#!system=ios
#!arguments=node:DIRECT
#!arguments-desc=node:\n选择用于检测 TikTok 解锁状态的策略组或单个节点（如 DIRECT, Proxy, TikTok 或节点名称）

[Script]
# 使用 {{{node}}} 动态绑定 UI 界面中选择的节点/策略
TikTok-Check = type=generic,script-path=https://raw.githubusercontent.com/renogcp/Surge/refs/heads/master/scripts/tiktok-check.js,timeout=10,argument=policy={{{node}}}

[Panel]
TikTok-Check = script-name=TikTok-Check,update-interval=3600
