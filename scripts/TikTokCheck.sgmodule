#!name=TikTok 解锁检测 Panel
#!desc=支持自由选择策略/节点检测 TikTok 解锁状态
#!category=检测工具
#!system=ios

[Script]
# 开启 node-change=true 即可在 Panel 上自由切换节点/策略
TikTok-Check = type=generic,script-path=https://raw.githubusercontent.com/renogcp/Surge/refs/heads/master/scripts/tiktok-check.js,timeout=10,node-change=true

[Panel]
TikTok-Check = script-name=TikTok-Check,update-interval=3600
